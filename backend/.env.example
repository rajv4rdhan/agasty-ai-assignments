# Database Configuration
# For local development (IDE): use localhost
# For Docker Compose: this file is used, but DB_HOST will be overridden to 'postgres'
DB_HOST=localhost
DB_PORT=5432
DB_NAME=ragdb
DB_USER=raguser
DB_PASSWORD=ragpass

# Gemini AI Configuration (Google AI Studio API Key)
GEMINI_API_KEY=your-gemini-api-key-here
GEMINI_MODEL=gemini-3.5-flash-lite
GEMINI_EMBEDDING_MODEL=text-embedding-004

OCR_API_KEY

# Note: When running with docker-compose.yml, DB_HOST is automatically set to 'postgres'